# Variables de entorno del backend (Render). Copia y completa en el panel de Render.

SPRING_PROFILES_ACTIVE=prod

# ── Base de datos (TiDB Cloud / MySQL) ──────────────────────────────────────
# IMPORTANTE: incluir SSL. Ejemplo TiDB Cloud Serverless:
VL_DB_URL=jdbc:mysql://HOST:4000/DATABASE?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&serverTimezone=America/Lima
VL_DB_USER=tu_usuario
DB_PASS=tu_password

# ── Seguridad ───────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (mantener estable: si cambia, no se descifran los secretos)
SECRETS_ENCRYPTION_KEY=

# ── Semilla del admin (solo si la BD está vacía) ────────────────────────────
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=UnaClaveFuerte#2026
SEED_DEMO_VENDEDOR=false

# ── CORS: dominio del frontend en Vercel ────────────────────────────────────
# Puedes poner el dominio exacto. Si usas previews: https://*.vercel.app
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# ── Integraciones ───────────────────────────────────────────────────────────
DECOLECTA_TOKEN=
SUNAT_API_URL=https://tu-api-sunat
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
